# Contact form → Telegram (required for the form to deliver messages)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional public settings
NEXT_PUBLIC_SITE_URL=https://moonlab.space
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CAL_LINK=

# Client portal (/login, /dashboard) runs on Cloudflare D1 through the `DB` binding in
# wrangler.jsonc; it needs no variables here. See docs/PORTAL.md.
#
# Optional Google sign-in: set these as Wrangler secrets in production
#   npx wrangler secret put GOOGLE_CLIENT_ID
#   npx wrangler secret put GOOGLE_CLIENT_SECRET
# and in .dev.vars for local `wrangler dev`. Leave unset to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
