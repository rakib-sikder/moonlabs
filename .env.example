# Contact form → Telegram (required for the form to deliver messages)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional public settings
NEXT_PUBLIC_SITE_URL=https://moonlabs.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CAL_LINK=

# Client portal (/login, /dashboard) - Supabase. Both are PUBLIC values (safe in the browser);
# row-level security in supabase/migrations/0001_portal.sql protects the data.
# Leave empty and the portal shows "not configured yet" while the rest of the site works.
# Never put the service-role key here or anywhere in this app. See docs/PORTAL.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
